{
  "name": "agentinbox",
  "version": "0.1.0",
  "description": "Local-first task inbox and brief generator for coding agents.",
  "type": "module",
  "main": "./dist/src/index.js",
  "bin": {
    "agentinbox": "./dist/src/cli.js"
  },
  "exports": {
    "0": [
      "./dist/src/index.js"
    ],
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "fixtures",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "smoke": "npm run build && bash scripts/smoke.sh",
    "test": "npm run build && node --test dist/test/*.test.js",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm run check && npm test && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "agent",
    "cli",
    "local-first",
    "task-inbox",
    "typescript"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rogerchappel/agentinbox"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/agentinbox/issues"
  },
  "homepage": "https://github.com/rogerchappel/agentinbox#readme"
}
